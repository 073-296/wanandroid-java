<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/new_edit_iv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_manage_group_edit"
        app:tint="?attr/colorOnSurfaceVariant"
        android:scaleType="fitXY"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="7dp"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/new_edit_et"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/new_edit_iv"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/new_edit_iv"
        app:layout_constraintEnd_toStartOf="@+id/new_garbage_iv"
        android:inputType="text"
        android:textSize="20dp"/>

    <ImageView
        android:id="@+id/new_garbage_iv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_garbage"
        app:tint="?attr/colorOnSurfaceVariant"
        android:scaleType="fitXY"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@+id/new_edit_et"
        app:layout_constraintEnd_toStartOf="@+id/new_confirm_iv"
        app:layout_constraintBottom_toBottomOf="@+id/new_edit_et"/>

    <ImageView
        android:id="@+id/new_confirm_iv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_confirm"
        app:tint="?attr/colorOnSurfaceVariant"
        android:scaleType="fitXY"
        android:layout_marginEnd="10dp"
        android:layout_marginStart="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@+id/new_garbage_iv"
        app:layout_constraintBottom_toBottomOf="@+id/new_garbage_iv"/>

</androidx.constraintlayout.widget.ConstraintLayout>