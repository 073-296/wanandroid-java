<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/sort_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:text="@string/sort_way"
        android:textStyle="bold"
        android:textSize="20dp"/>

    <TextView
        android:id="@+id/mix_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/sort_title"
        android:text="@string/mix"
        android:textSize="20dp"/>

    <TextView
        android:id="@+id/order_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/mix_text"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center"
        android:text="@string/order"
        android:textSize="20dp"/>

    <TextView
        android:id="@+id/cancel_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        app:layout_constraintTop_toBottomOf="@+id/order_text"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center"
        android:text="@string/cancel"
        android:textSize="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>