<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.fragment.AccountFragment"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/account_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="8dp"
        android:textStyle="bold"
        android:text="@string/account"
        android:textSize="30dp"/>

    <ImageView
        android:id="@+id/account_image"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_account"
        android:scaleType="fitXY"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/account_text"/>

    <TextView
        android:id="@+id/account_welcome_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/account_image"
        android:layout_marginTop="10dp"
        android:textSize="30dp"
        app:layout_constraintTop_toTopOf="@+id/account_image"/>

    <Button
        android:id="@+id/change_password_bt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/account_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/change_account_bt"
        android:text="@string/change_password"
        android:textSize="20dp"/>

    <Button
        android:id="@+id/change_account_bt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/change_password_bt"
        app:layout_constraintStart_toEndOf="@+id/change_password_bt"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/change_account"
        android:textSize="20dp"/>

    <Button
        android:id="@+id/logout_account_bt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/change_password_bt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/exit_account_bt"
        android:text="@string/logout_account"
        android:textSize="20dp"/>

    <Button
        android:id="@+id/exit_account_bt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/logout_account_bt"
        app:layout_constraintStart_toEndOf="@+id/logout_account_bt"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/exit_account"
        android:textSize="20dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>